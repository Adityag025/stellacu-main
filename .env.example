# Backend settings. Copy this file to .env.local for local development
# (npm run serve). In production set the same names in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values: .env.local is git-ignored.

# --- Email (required for the contact, audit and landing forms) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Its domain must be verified in Resend → Domains.
MAIL_FROM=StellAcu Website <website@stellacumedia.com>
# Inbox(es) that receive enquiries, comma-separated.
MAIL_TO=sales@stellacumedia.com

# --- Newsletter (optional) ---
# If both are set, footer signups go to this Mailchimp audience.
# If not, each signup is emailed to MAIL_TO instead.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# true (default): Mailchimp sends a confirmation email before subscribing.
MAILCHIMP_DOUBLE_OPT_IN=true
